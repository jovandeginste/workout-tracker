package workouts

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ Edit(w *database.Workout) {
	@partials.Page(partials.NewPageOptions()) {
		<div class="gap-4">
			<h2>
				@helpers.IconFor(w.Type.String())
				@Name(w, 0)
				if w.HasCustomType() {
					<i>({ w.CustomType })</i>
				}
			</h2>
		</div>
		<div class="sm:flex sm:flex-wrap">
			<div class="basis-1/2">
				<div class="inner-form">
					<form method="post" action={ templ.SafeURL(helpers.RouteFor(ctx, "workout-update", w.ID)) }>
						<table>
							<thead>
								<tr>
									<td>
										<label for="type">{ i18n.T(ctx, "workout.type") }</label>
									</td>
									<td>
										<input type="hidden" name="id" value={ helpers.A2S(w.ID) }/>
										<select
											id="type"
											name="type"
											hx-get={ helpers.RouteFor(ctx, "workout-form") }
											hx-target="#workout-form"
											hx-trigger="load, input changed delay:300ms"
											hx-include="[name='id']"
										>
											@partials.WorkoutTypeOptions(w.Type.String(), false, false)
										</select>
									</td>
								</tr>
							</thead>
							@partials.WorkoutFormPlaceholder()
							@partials.FormActions("workout.update", helpers.RouteFor(ctx, "workout-show", w.ID))
						</table>
					</form>
				</div>
			</div>
			<div class="basis-1/4">
				@FullWorkoutDetails(w)
			</div>
		</div>
	}
}
