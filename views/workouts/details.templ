package workouts

import (
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
	"math"
)

templ EventTitle(w *database.Workout, preferredUnits *database.UserPreferredUnits) {
	@helpers.IconFor(w.Type.String())
	switch  {
		case w.Type.IsDistance():
			{ helpers.HumanDistanceForWorkout(ctx, w, w.Distance()) }
			{ helpers.DistanceUnitForWorkout(ctx, w) }
		case w.Type.IsWeight():
			{ helpers.HumanWeight(ctx, w.Weight()) } { preferredUnits.Weight() }
		case w.Type.IsRepetition():
			{ helpers.A2S(w.Repetitions()) }
		default:
			{ w.Name }
	}
}

templ Name(w *database.Workout, maxLength int) {
	@partials.TruncatedName(w.Name, maxLength)
}

templ Details(w *database.Workout) {
	{{ currentUser := helpers.CurrentUser(ctx) }}
	<table>
		<tbody>
			<tr>
				<td>
					@helpers.IconFor("name")
				</td>
				<td class="max-w-[0px] overflow-hidden whitespace-nowrap text-ellipsis">
					<a href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-show", w.ID)) }>
						@Name(w, 0)
					</a>
				</td>
			</tr>
			<tr>
				<td>
					@helpers.IconFor("date")
				</td>
				<td>
					@partials.SnippetDate(w.Date)
				</td>
			</tr>
			<tr>
				<td>
					@helpers.IconFor("workout")
				</td>
				<td>
					<span>
						@helpers.IconFor(w.Type.String())
						if w.HasCustomType() {
							<i>{ w.CustomType }</i>
						} else {
							{ i18n.T(ctx, w.Type.StringT()) }
						}
					</span>
				</td>
			</tr>
			if w.Type.IsRepetition() {
				<tr>
					<td>
						@helpers.IconFor("repetitions")
					</td>
					<td class="whitespace-nowrap font-mono">{ helpers.A2S(w.TotalRepetitions()) }</td>
				</tr>
				<tr>
					<td>
						@helpers.IconFor("tempo")
					</td>
					<td class="whitespace-nowrap font-mono">
						{ helpers.A2S(w.RepetitionFrequencyPerMinute()) }
					</td>
				</tr>
			}
			if w.Type.IsWeight() {
				<tr>
					<td>
						@helpers.IconFor("weight")
					</td>
					<td class="whitespace-nowrap font-mono">
						{ helpers.HumanWeight(ctx, w.Weight()) }
						{ currentUser.PreferredUnits().Weight() }
					</td>
				</tr>
			}
			if w.Type.IsDuration() {
				<tr>
					<td>
						@helpers.IconFor("duration")
					</td>
					<td class="whitespace-nowrap font-mono">
						@showLocked(w)
						{ helpers.HumanDuration (w.TotalDuration()) }
					</td>
				</tr>
			}
			if w.Type.IsDistance() {
				<tr>
					<td>
						@helpers.IconFor("distance")
					</td>
					<td class="whitespace-nowrap font-mono">
						@showLocked(w)
						{ helpers.HumanDistanceForWorkout(ctx, w, w.TotalDistance()) }
						{ helpers.DistanceUnitForWorkout(ctx, w) }
					</td>
				</tr>
			}
			if w.Type.IsDistance() && w.Type.IsDuration() {
				<tr>
					<td>
						@helpers.IconFor("speed")
					</td>
					<td class="whitespace-nowrap font-mono">
						{ helpers.HumanSpeedForWorkout(ctx, w, w.AverageSpeed() ) }
						{ helpers.SpeedUnitForWorkout(ctx, w) }
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ FullWorkoutDetails(w *database.Workout) {
	{{ currentUser := helpers.CurrentUser(ctx) }}
	<table>
		<tbody>
			@partials.DetailRow("user", "user.username", "") {
					@helpers.UserLinkWithName(w.User)
			}
			if w.HasFile() {
				@partials.DetailRow("file", "common.file", "") {
						if len(w.Filename()) > 15 {
							<abbr title={ w.Filename() }>{ fmt.Sprintf("%.15s", w.Filename()) }...</abbr>
						} else {
							{ w.Filename() }
						}
				}
			}
			@partials.DetailRow("date", "common.date", "") {
					<a
						href="#"
						onclick="document.getElementById('timeinfo').classList.toggle('hidden'); return false;"
					>
						@helpers.IconFor("timezone")
					</a>
					@partials.SnippetDate(w.Date)
					<div id="timeinfo" class="hidden">
						<ul>
							<li>{ currentUser.Timezone().String() }: { helpers.LocalTime(ctx, w.Date).String() }</li>
							<li>UTC: { helpers.InTimezone( w.Date, "UTC").String() }</li>
							<li>{ w.Timezone() }: { helpers.InTimezone(w.Date, w.Timezone()).String() }</li>
						</ul>
					</div>
			}
			@partials.DetailRow("location", "workout.location", "") {
					@showLocked(w)
					{ w.Address() }
			}
			<tr>
				<td>
					@helpers.IconFor("source")
				</td>
				<th>{ i18n.T(ctx, "workout.source") }</th>
				<td>{ w.Creator() }</td>
			</tr>
			@partials.DetailRow("workout", "common.type", "") {
					<span>
						@helpers.IconFor(w.Type.String())
						if w.HasCustomType() {
							<i>{ w.CustomType }</i>
						} else {
							{ i18n.T(ctx, w.Type.StringT()) }
						}
					</span>
			}
			if w.Type.IsRepetition() {
				<tr>
					<td>
						@helpers.IconFor("repetitions")
					</td>
					<th>{ i18n.T(ctx, "workout.repetitions") }</th>
					<td class="whitespace-nowrap font-mono">{ helpers.A2S(w.TotalRepetitions()) }</td>
				</tr>
				@partials.DetailRow("tempo", "workout.average-per-minute", "whitespace-nowrap font-mono") {
						{ helpers.A2S(w.RepetitionFrequencyPerMinute()) }
				}
			}
			if w.Type.IsWeight() {
				@partials.DetailRow("weight", "common.weight", "whitespace-nowrap font-mono") {
						{ helpers.HumanWeight(ctx, w.Weight()) }
						{ currentUser.PreferredUnits().Weight() }
				}
			}
			if w.Type.IsDuration() {
				@partials.DetailRow("duration", "workout.total-duration", "whitespace-nowrap font-mono") {
						@showLocked(w)
						{ helpers.HumanDuration(w.TotalDuration() ) }
				}
				if w.PauseDuration() > 0 {
					@partials.DetailRow("pause", "workout.time-paused", "whitespace-nowrap font-mono") {
							{ helpers.HumanDuration (w.PauseDuration() ) }
					}
				}
			}
			if w.Type.IsDistance() {
				@partials.DetailRow("distance", "workout.total-distance", "whitespace-nowrap font-mono") {
						@showLocked(w)
						{ helpers.HumanDistanceForWorkout(ctx, w, w.TotalDistance()) }
						{ helpers.DistanceUnitForWorkout(ctx, w) }
						if w.TotalDistance2D() > 0 && math.Abs((w.TotalDistance() / w.TotalDistance2D()) - 1) > 0.1 {
							// Only print 2D distance if the difference is greater than 10%
							(2D:
							{ helpers.HumanDistanceForWorkout(ctx, w, w.TotalDistance2D()) }
							{ helpers.DistanceUnitForWorkout(ctx, w) })
						}
				}
			}
			if w.Type.IsDistance() &&  w.Type.IsDuration() {
				@partials.DetailRow("speed", "workout.average-speed", "whitespace-nowrap font-mono") {
						{ helpers.HumanSpeedForWorkout(ctx, w, w.AverageSpeed()) }
						{ helpers.SpeedUnitForWorkout(ctx, w) }
				}
				if w.PauseDuration() != 0 {
					@partials.DetailRow("speed", "workout.average-speed-no-pause", "whitespace-nowrap font-mono") {
							{ helpers.HumanSpeedForWorkout(ctx, w, w.AverageSpeedNoPause() ) }
							{ helpers.SpeedUnitForWorkout(ctx, w) }
					}
				}
				@partials.DetailRow("tempo", "workout.average-tempo", "whitespace-nowrap font-mono") {
						{ helpers.HumanTempoForWorkout(ctx, w, w.AverageSpeed() ) }
						{ helpers.TempoUnitForWorkout(ctx, w) }
				}
				@partials.DetailRow("max-speed", "workout.max-tempo", "whitespace-nowrap font-mono") {
						{ helpers.HumanTempoForWorkout(ctx, w, w.MaxSpeed() ) }
						{ helpers.TempoUnitForWorkout(ctx, w) }
				}
				if  w.PauseDuration()!= 0 {
					@partials.DetailRow("tempo", "workout.average-tempo-no-pause", "whitespace-nowrap font-mono") {
							{ helpers.HumanTempoForWorkout(ctx, w, w.AverageSpeedNoPause()) }
							{ helpers.TempoUnitForWorkout(ctx, w) }
					}
				}
				@partials.DetailRow("max-speed", "workout.max-speed", "whitespace-nowrap font-mono") {
						{ helpers.HumanSpeedForWorkout(ctx, w, w.MaxSpeed()) }
						{ helpers.SpeedUnitForWorkout(ctx, w) }
				}
				if w.HasCadence() {
					@partials.DetailRow("cadence", "workout.cadence-avg-max", "whitespace-nowrap font-mono") {
							{ helpers.HumanCadence (w.AverageCadence()) }
							{ currentUser.PreferredUnits().Cadence() } /
							{ helpers.HumanCadence (w.MaxCadence()) }
							{ currentUser.PreferredUnits().Cadence() }
					}
				}
			}
			if w.Type.IsLocation() {
				if w.HasElevation() {
					if w.MinElevation() != 0 {
						@partials.DetailRow("elevation", "workout.min-elevation", "whitespace-nowrap font-mono") {
								{ helpers.HumanElevation (ctx,w.MinElevation() ) } { currentUser.PreferredUnits().Elevation() }
						}
					}
					if w.MaxElevation() != 0 {
						@partials.DetailRow("elevation", "workout.max-elevation", "whitespace-nowrap font-mono") {
								{ helpers.HumanElevation (ctx,w.MaxElevation() ) } { currentUser.PreferredUnits().Elevation() }
						}
					}
					if w.TotalUp() != 0 {
						@partials.DetailRow("up", "workout.total-up", "whitespace-nowrap font-mono") {
								{ helpers.HumanElevation (ctx,w.TotalUp() ) } { currentUser.PreferredUnits().Elevation() }
						}
					}
					if w.TotalDown() != 0 {
						@partials.DetailRow("down", "workout.total-down", "whitespace-nowrap font-mono") {
								{ helpers.HumanElevation (ctx,w.TotalDown() ) } { currentUser.PreferredUnits().Elevation() }
						}
					}
				}
			}
			if w.HasCalories() {
				<tr>
					<td>
						@helpers.IconFor("calories")
					</td>
					<th>
						if w.HasCaloriesEstimate() {
							{ i18n.T(ctx, "workout.est-calories-burned") }
							<a
								href="#"
								title={ i18n.T(ctx, "workout.calories-hint") }
							>
								@helpers.IconFor("info")
							</a>
						} else {
							{ i18n.T(ctx, "workout.calories-burned") }
						}
					</th>
					<td class="whitespace-nowrap font-mono">
						{ helpers.HumanCalories (w.CaloriesBurned() ) }
						{ currentUser.PreferredUnits().Calories() }
						if w.HasCaloriesEstimate() {
							({ helpers.HumanWeight(ctx, w.User.WeightAt(w.Date)) }
							{ currentUser.PreferredUnits().Weight() })
						}
					</td>
				</tr>
			}
			if w.HasPower() {
				@partials.DetailRow("power", "workout.power-avg-max", "whitespace-nowrap font-mono") {
						{ helpers.HumanPower (w.AveragePower()) }
						{ currentUser.PreferredUnits().Power() } /
						{ helpers.HumanPower (w.MaxPower()) }
						{ currentUser.PreferredUnits().Power() }
				}
			}
			<tr>
				<td>
					@helpers.IconFor("equipment")
				</td>
				<td>{ i18n.T(ctx, "menu.equipment") }</td>
				<td>
					if len(w.Equipment) > 0 {
						for _, e := range w.Equipment {
							<a href={ templ.SafeURL(helpers.RouteFor(ctx, "equipment-show", e.ID)) }>{ e.Name }</a>
						}
					} else {
						<i>{ i18n.T(ctx, "workout.no-equipment") }</i>
					}
				</td>
			</tr>
			if w.HasExtraMetrics() {
				<tr>
					<td>
						@helpers.IconFor("metrics")
					</td>
					<td>{ i18n.T(ctx, "workout.extra-metrics") }</td>
					<td class="flex flex-wrap gap-1">
						for _, m := range w.Data.ExtraMetrics {
							<div title={ i18n.T(ctx, "workout."+m) }>
								@helpers.IconFor(m)
							</div>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ showLocked(w *database.Workout) {
	if w.Locked {
		<span class="dangerous" title={ i18n.T(ctx, "workout.attribute-locked") }>
			@helpers.IconFor("locked")
		</span>
	}
}
