package workouts

import (
	"context"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/spf13/cast"
)

func translationMap(ctx context.Context) map[string]string {
	return map[string]string{
		"distance":     i18n.T(ctx, "workout.distance"),
		"duration":     i18n.T(ctx, "workout.duration"),
		"calories":     i18n.T(ctx, "workout.calories"),
		"power":        i18n.T(ctx, "workout.power"),
		"heart-rate":   i18n.T(ctx, "workout.heart-rate"),
		"temperature":  i18n.T(ctx, "workout.temperature"),
		"speed":        i18n.T(ctx, "workout.speed"),
		"elevation":    i18n.T(ctx, "workout.elevation"),
		"cadence":      i18n.T(ctx, "workout.cadence"),
		"averagespeed": i18n.T(ctx, "workout.average-speed"),
		"slope":        i18n.T(ctx, "workout.slope"),
	}
}

func labelMap(ctx context.Context, w *database.Workout) map[string]*helpers.Dataset {
	data := map[string]*helpers.Dataset{
		"position":        {Label: "", Data: []any{}},
		"time":            {Label: i18n.T(ctx, "workout.time"), Data: []any{}},
		"distance":        {Label: i18n.T(ctx, "workout.distance"), Data: []any{}},
		"speed":           {Label: i18n.T(ctx, "workout.speed"), Data: []any{}},
		"duration":        {Label: i18n.T(ctx, "workout.duration"), Data: []any{}},
		"moving-duration": {Label: i18n.T(ctx, "workout.moving-duration"), Data: []any{}},
		"slope":           {Label: i18n.T(ctx, "workout.slope"), Data: []any{}},
	}

	translations := translationMap(ctx)

	for _, m := range w.Data.ExtraMetrics {
		data[m] = &helpers.Dataset{Label: translations[m], Data: []any{}}
	}

	return data
}

func addDetails(ctx context.Context, data map[string]*helpers.Dataset, w *database.Workout) {
	d := w.Details()
	if d == nil {
		return
	}

	// The moving duration is calculated here, and not stored with the points,
	// so that it also works for workouts that were processed before this
	// feature existed.
	movingDuration := 0.0

	for _, p := range d.Points {
		s := 0.0
		if ems, ok := p.ExtraMetrics["speed"]; ok && ems > 0 {
			s = ems
		} else {
			s = p.AverageSpeed()
		}

		if p.Lat != 0 || p.Lng != 0 {
			data["position"].Data = append(data["position"].Data, []float64{p.Lat, p.Lng})
		} else {
			data["position"].Data = append(data["position"].Data, nil)
		}

		data["time"].Data = append(data["time"].Data, p.Time)
		data["distance"].Data = append(data["distance"].Data, helpers.HumanDistanceForWorkout(ctx, w, p.TotalDistance))
		data["duration"].Data = append(data["duration"].Data, p.TotalDuration.Seconds())

		if p.IsMoving() {
			movingDuration += p.Duration.Seconds()
		}

		data["moving-duration"].Data = append(data["moving-duration"].Data, movingDuration)
		data["slope"].Data = append(data["slope"].Data, p.SlopeGrade)
		data["speed"].Data = append(data["speed"].Data, cast.ToFloat64(helpers.HumanSpeedForWorkout(ctx, w, s)))

		for _, m := range w.Data.ExtraMetrics {
			switch m {
			case "speed", "distance":
				continue
			}

			if v, ok := p.ExtraMetrics[m]; ok {
				data[m].Data = append(data[m].Data, v)
			} else {
				data[m].Data = append(data[m].Data, nil)
			}
		}
	}
}

templ DataJson(w *database.Workout) {
	{{ pu := helpers.PreferredUnitsToJSON(helpers.CurrentUser(ctx).PreferredUnits()) }}
	{{
		if w.Type.IsNautical() {
			pu["distance"] = "nm"
			pu["speed"] = "kn"
			pu["tempo"] = "min/nm"
		}
	}}
	{{ data := labelMap(ctx, w) }}
	{{ addDetails(ctx, data, w) }}
	@templ.JSONScript("workout-preferred-units", pu)
	@templ.JSONScript("workout-data", data)
}
