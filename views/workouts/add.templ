package workouts

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ Add() {
	@partials.Page(partials.NewPageOptions()) {
		<h2>
			@helpers.IconFor("workout-add")
			{ i18n.T(ctx, "workout.add-a-workout") }
		</h2>
		<div class="sm:flex sm:flex-wrap [&>*]:basis-1/2">
			<div>
				<div class="inner-form">
					<h3>{ i18n.T(ctx, "common.use-a-file") }</h3>
					<form
						id="upload"
						method="post"
						action={ templ.SafeURL(helpers.RouteFor(ctx, "workouts-create")) }
						enctype="multipart/form-data"
					>
						<table class="sm:table-fixed">
							<tbody>
								@partials.FileInputRow()
								<tr>
									<td>
										<label for="type">{ i18n.T(ctx, "common.type") }</label>
									</td>
									<td>
										<select id="type" name="type">
											@partials.WorkoutTypeOptions("", true, false)
										</select>
									</td>
								</tr>
								<tr>
									<td>
										<label for="notes">{ i18n.T(ctx, "common.notes") }</label>
									</td>
									<td>
										<textarea
											type="text"
											id="notes"
											name="notes"
											rows="4"
										></textarea>
									</td>
								</tr>
								<tr>
									<td>
										<label>{ i18n.T(ctx, "help.resources") }</label>
									</td>
									<td>
										<div>
											<ul>
												{ i18n.T(ctx, "help.edit-gpx-files") }
												<li>{ i18n.T(ctx, "misc.split-tracks") }</li>
												<li>{ i18n.T(ctx, "misc.convert-format") }</li>
												<li>{ i18n.T(ctx, "misc.trim-workout") }</li>
											</ul>
											<ul>
												{ i18n.T(ctx, "help.try-sites") }
												<li><a target="_blank" href="https://gpx.studio/">gpx.studio — the online GPX file editor</a></li>
												<li><a target="_blank" href="https://kml2gpx.com/">Kml2gpx.com: convert kml to gpx online</a></li>
												<li><a target="_blank" href="https://www.fitfileviewer.com/">FIT File Viewer</a></li>
											</ul>
										</div>
									</td>
								</tr>
							</tbody>
							<tfoot>
								<tr>
									<td></td>
									<td>
										<button type="submit">{ i18n.T(ctx, "workout.add-workouts") }</button>
									</td>
								</tr>
							</tfoot>
						</table>
					</form>
				</div>
			</div>
			<div>
				<div class="inner-form">
					<h3>{ i18n.T(ctx, "workout.manual") }</h3>
					<form id="manual" method="post" action={ templ.SafeURL(helpers.RouteFor(ctx, "workouts-create")) }>
						<table class="sm:table-auto">
							<thead>
								<tr>
									<td>
										<label for="type">{ i18n.T(ctx, "workout.type") }</label>
									</td>
									<td>
										<select
											id="type"
											name="type"
											hx-get={ helpers.RouteFor(ctx, "workout-form") }
											hx-target="#workout-form"
											hx-trigger="input changed delay:300ms"
										>
											<option value="select" selected>Select...</option>
											@partials.WorkoutTypeOptions("", false, false)
										</select>
									</td>
								</tr>
							</thead>
							@partials.WorkoutFormPlaceholder()
							<tfoot>
								<tr>
									<td></td>
									<td>
										<button type="submit">{ i18n.T(ctx, "workout.add-workouts") }</button>
									</td>
								</tr>
							</tfoot>
						</table>
					</form>
				</div>
			</div>
		</div>
	}
}
