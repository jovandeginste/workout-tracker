package partials

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
)

templ Header() {
	{{ currentUser := helpers.CurrentUser(ctx) }}
	<div class="menu md:flex md:flex-wrap gap-4">
		<h1>
			<a href={ templ.SafeURL(helpers.RouteFor(ctx, "dashboard")) }>
				<img src={ helpers.RouteFor(ctx, "assets") + "/logo.png" } alt="Workout Tracker"/>
				<span>Workout Tracker</span>
			</a>
		</h1>
		if currentUser.IsActive() {
			<div class="grow flex flex-wrap">
				<div class="grow flex flex-wrap justify-start">
					for _, l := range []struct{ route, icon, label string }{
						{"dashboard", "dashboard", "menu.dashboard"},
						{"workouts", "workout", "menu.workouts"},
						{"daily", "scale", "menu.measurements"},
						{"statistics", "statistics", "menu.statistics"},
						{"heatmap", "heatmap", "menu.heatmap"},
						{"route-segments", "route-segment", "menu.route-segments"},
						{"equipment", "equipment", "menu.equipment"},
					} {
						@menuLink(l.route, l.icon, l.label)
					}
				</div>
				<div class="flex flex-wrap md:min-w-[400px] justify-end">
					if currentUser.Admin {
						<div>
							<a href={ templ.SafeURL(helpers.RouteFor(ctx, "admin")) }>
								@helpers.IconFor("admin")
								<span class="autohide">{ i18n.T(ctx, "admin.manage") }</span>
							</a>
						</div>
					}
					<div>
						<a href={ templ.SafeURL(helpers.RouteFor(ctx, "user-profile")) } title={ currentUser.Username }>
							@helpers.IconFor("user-profile")
							{ currentUser.DisplayName() }
						</a>
					</div>
					<div class="-mr-5">
						<a href={ templ.SafeURL(helpers.RouteFor(ctx, "user-signout")) }>
							@helpers.IconFor("user-signout")
							<span class="autohide">{ i18n.T(ctx, "user.logout") }</span>
						</a>
					</div>
				</div>
			</div>
		} else {
			<div class="md:grow flex flex-wrap justify-end md:justify-start"></div>
		}
		if currentUser == nil || currentUser.Profile.Language == "" ||  currentUser.Profile.Language == "browser" {
			<div
				class="flex flex-wrap md:min-w-[400px] justify-end mt-3 md:mt-0 pt-3 md:pt-0 border-neutral-500 border-t-2 md:border-t-0"
			>
				@Language()
			</div>
		}
	</div>
	@Alerts()
	@Version()
}

templ menuLink(route, icon, labelKey string) {
	<div>
		<a href={ templ.SafeURL(helpers.RouteFor(ctx, route)) }>
			@helpers.IconFor(icon)
			<span class="autohide">{ i18n.T(ctx, labelKey) }</span>
		</a>
	</div>
}
