package user

import (
	"context"
	"strings"

	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ profilePreferredUnits() {
	{{ pu := helpers.CurrentUser(ctx).PreferredUnits() }}
	<form
		method="post"
		action={ templ.SafeURL(helpers.RouteFor(ctx, "user-profile-preferred-units-update")) }
	>
		<table class="table-fixed">
			<tbody>
				@unitSelect("speed", "workout.speed", "speed", pu.Speed(nil), []helpers.TranslatedKey{
					{Key: "kph", Translation: "units.kilometers-per-hour"},
					{Key: "mph", Translation: "units.miles-per-hour"},
				})
				@unitSelect("distance", "workout.distance", "distance", pu.Distance(nil), []helpers.TranslatedKey{
					{Key: "km", Translation: "units.kilometers"},
					{Key: "mi", Translation: "units.miles"},
				})
				@unitSelect("elevation", "workout.elevation", "elevation", pu.Elevation(), []helpers.TranslatedKey{
					{Key: "m", Translation: "units.meters"},
					{Key: "ft", Translation: "units.feet"},
				})
				@unitSelect("weight", "common.weight", "weight", pu.Weight(), []helpers.TranslatedKey{
					{Key: "lbs", Translation: "units.pounds"},
					{Key: "kg", Translation: "units.kilograms"},
				})
				@unitSelect("height", "common.height", "height", pu.Height(), []helpers.TranslatedKey{
					{Key: "in", Translation: "units.inch"},
					{Key: "cm", Translation: "units.centimeter"},
				})
			</tbody>
		</table>
	</form>
}

templ profileTotalsShow(types database.WorkoutTypeList) {
	<details>
		<summary class="cursor-pointer">{ totalsShowSummary(ctx, types) }</summary>
		<div class="flex flex-wrap">
			<label class="inline">
				<input
					class="sr-only peer"
					type="checkbox"
					name="totals_show"
					value={ database.WorkoutTypeAutoDetect.String() }
					checked?={ types.Has(database.WorkoutTypeAutoDetect) }
				/>
				<span class="selectable-pill">{ i18n.T(ctx, "workout.autodetect") }</span>
			</label>
			for _, wt := range helpers.WorkoutTypes() {
				if wt.IsDistance() {
					@partials.SelectablePill("totals_show_"+wt.String(), "totals_show", wt.String(), i18n.T(ctx, wt.StringT()), "", types.Has(wt))
				}
			}
		</div>
	</details>
}

func totalsShowSummary(ctx context.Context, types database.WorkoutTypeList) string {
	if len(types) == 0 {
		return i18n.T(ctx, database.WorkoutTypeAutoDetect.StringT())
	}

	names := make([]string, 0, len(types))
	for _, wt := range types {
		names = append(names, i18n.T(ctx, wt.StringT()))
	}

	return strings.Join(names, ", ")
}

templ profileTimezone(utz string) {
	<select class="input-ellipsis" id="timezone" name="timezone">
		<option></option>
		for _, tz := range helpers.Timezones() {
			<option value={ tz.Name } selected?={ tz.Name == utz }>
				{ tz.Description }
			</option>
		}
	</select>
}

templ profileLanguage(ulang string) {
	<select class="input-ellipsis" id="language" name="language">
		<option value="browser" selected?={ ulang == "browser" }>
			🌐 Browser language
		</option>
		@partials.LanguageOptions(ulang)
	</select>
}

templ unitSelect(id, labelKey, icon, current string, options []helpers.TranslatedKey) {
	<tr>
		<th>
			<label for={ id }>
				@helpers.IconFor(icon)
				{ i18n.T(ctx, labelKey) }
			</label>
		</th>
		<td>
			<select class="input-ellipsis" id={ id } name={ id }>
				for _, o := range options {
					<option value={ o.Key } selected?={ current == o.Key }>
						{ i18n.T(ctx, o.Translation) }
					</option>
				}
			</select>
		</td>
	</tr>
}
