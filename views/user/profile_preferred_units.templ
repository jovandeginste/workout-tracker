package user

import (
	"context"
	"strings"

	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
)

templ profilePreferredUnits() {
	{{ pu := helpers.CurrentUser(ctx).PreferredUnits() }}
	<form
		method="post"
		action={ templ.SafeURL(helpers.RouteFor(ctx, "user-profile-preferred-units-update")) }
	>
		<table class="table-fixed">
			<tbody>
				<tr>
					<th>
						<label for="speed">
							@helpers.IconFor("speed")
							{ i18n.T(ctx, "workout.speed") }
						</label>
					</th>
					<td>
						<select class="input-ellipsis" id="speed" name="speed">
							<option value="kph" selected?={ pu.Speed(nil) == "kph" }>
								{ i18n.T(ctx, "units.kilometers-per-hour") }
							</option>
							<option value="mph" selected?={ pu.Speed(nil) == "mph" }>
								{ i18n.T(ctx, "units.miles-per-hour") }
							</option>
						</select>
					</td>
				</tr>
				<tr>
					<th>
						<label for="distance">
							@helpers.IconFor("distance")
							{ i18n.T(ctx, "workout.distance") }
						</label>
					</th>
					<td>
						<select class="input-ellipsis" id="distance" name="distance">
							<option value="km" selected?={ pu.Distance(nil) == "km" }>
								{ i18n.T(ctx, "units.kilometers") }
							</option>
							<option value="mi" selected?={ pu.Distance(nil) == "mi" }>
								{ i18n.T(ctx, "units.miles") }
							</option>
						</select>
					</td>
				</tr>
				<tr>
					<th>
						<label for="elevation">
							@helpers.IconFor("elevation")
							{ i18n.T(ctx, "workout.elevation") }
						</label>
					</th>
					<td>
						<select class="input-ellipsis" id="elevation" name="elevation">
							<option value="m" selected?={ pu.Elevation() == "m" }>
								{ i18n.T(ctx, "units.meters") }
							</option>
							<option value="ft" selected?={ pu.Elevation() == "ft" }>
								{ i18n.T(ctx, "units.feet") }
							</option>
						</select>
					</td>
				</tr>
				<tr>
					<th>
						<label for="weight">
							@helpers.IconFor("weight")
							{ i18n.T(ctx, "common.weight") }
						</label>
					</th>
					<td>
						<select class="input-ellipsis" id="weight" name="weight">
							<option value="lbs" selected?={ pu.Weight() == "lbs" }>
								{ i18n.T(ctx, "units.pounds") }
							</option>
							<option value="kg" selected?={ pu.Weight() == "kg" }>
								{ i18n.T(ctx, "units.kilograms") }
							</option>
						</select>
					</td>
				</tr>
				<tr>
					<th>
						<label for="height">
							@helpers.IconFor("height")
							{ i18n.T(ctx, "common.height") }
						</label>
					</th>
					<td>
						<select class="input-ellipsis" id="height" name="height">
							<option value="in" selected?={ pu.Height() == "in" }>
								{ i18n.T(ctx, "units.inch") }
							</option>
							<option value="cm" selected?={ pu.Height() == "cm" }>
								{ i18n.T(ctx, "units.centimeter") }
							</option>
						</select>
					</td>
				</tr>
				<tr>
					<td></td>
					<td>
						<button id="update-preferred-units" type="submit">{ i18n.T(ctx, "user.profile.update-units") }</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
}

templ profileTotalsShow(types database.WorkoutTypeList) {
	<details>
		<summary class="cursor-pointer">{ totalsShowSummary(ctx, types) }</summary>
		<div class="flex flex-wrap">
			<label class="inline">
				<input
					class="sr-only peer"
					type="checkbox"
					name="totals_show"
					value={ database.WorkoutTypeAutoDetect.String() }
					checked?={ types.Has(database.WorkoutTypeAutoDetect) }
				/>
				<span class="selectable-pill">{ i18n.T(ctx, "workout.autodetect") }</span>
			</label>
			for _, wt := range helpers.WorkoutTypes() {
				if wt.IsDistance() {
					<label class="inline">
						<input
							class="sr-only peer"
							type="checkbox"
							name="totals_show"
							value={ wt.String() }
							checked?={ types.Has(wt) }
						/>
						<span class="selectable-pill">{ i18n.T(ctx, wt.StringT()) }</span>
					</label>
				}
			}
		</div>
	</details>
}

func totalsShowSummary(ctx context.Context, types database.WorkoutTypeList) string {
	if len(types) == 0 {
		return i18n.T(ctx, database.WorkoutTypeAutoDetect.StringT())
	}

	names := make([]string, 0, len(types))
	for _, wt := range types {
		names = append(names, i18n.T(ctx, wt.StringT()))
	}

	return strings.Join(names, ", ")
}

templ profileTimezone(utz string) {
	<select class="input-ellipsis" id="timezone" name="timezone">
		<option></option>
		for _, tz := range helpers.Timezones() {
			<option value={ tz.Name } selected?={ tz.Name == utz }>
				{ tz.Description }
			</option>
		}
	</select>
}

templ profileLanguage(ulang string) {
	<select class="input-ellipsis" id="language" name="language">
		<option value="browser" selected?={ ulang == "browser" }>
			🌐 Browser language
		</option>
		for _, sl := range helpers.SupportedLanguages() {
			{{ linf := helpers.ToLanguageInformation(sl) }}
			<option value={ linf.Code } selected?={ linf.Code == ulang }>
				{ linf.Flag } { linf.LocalName }
				if linf.EnglishName != "" {
					if linf.EnglishName != linf.LocalName {
						({ linf.EnglishName })
					}
				}
			</option>
		}
	</select>
}
