package user

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/pkg/templatehelpers"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
	"time"
)

templ StatsRecordsTotal(user *database.User, viewer *database.User) {
	{{ totals, err := user.GetDefaultTotals(viewer) }}
	if err != nil {
		<pre>{ err.Error() }</pre>
	} else {
		{{ preferredUnits := helpers.CurrentUser(ctx).PreferredUnits() }}
		for _, t := range totals {
			<div class="md:flex md:flex-wrap">
				@StatisticTile(t.WorkoutType.String(), i18n.T(ctx, t.WorkoutType.StringT()), helpers.A2S(t.Workouts), "")
				@StatisticTile("distance", i18n.T(ctx, "workout.distance"), templatehelpers.HumanDistanceFor(preferredUnits.Distance(&t.WorkoutType))(t.Distance), preferredUnits.Distance(&t.WorkoutType))
				@StatisticTile("up", i18n.T(ctx, "workout.up"), helpers.HumanElevation(ctx, t.Up), preferredUnits.Elevation())
				@StatisticTile("duration", i18n.T(ctx, "workout.duration"), helpers.HumanDuration(t.Duration), "")
			</div>
		}
	}
}

templ StatisticTile(icon string, name string, value string, unit string) {
	<div class="md:basis-1/2 lg:basis-1/4">
		<div class="inner-form">
			<div class="grid grid-cols-3">
				<div class="text-3xl md:text-5xl text-center">
					@helpers.IconFor(icon)
				</div>
				<div class="col-span-2 grid grid-cols-1">
					<div
						class="text-xl md:text-3xl text-right font-mono md:h-8 overflow-hidden"
					>
						{ value } { unit }
					</div>
					<div class="text-neutral-600 dark:text-neutral-400 text-sm text-right">
						{ name }
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ StatsRecordDate(id uint64, date time.Time) {
	<span class="hidden xl:inline">
		<a href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-show", id)) }>
			{ helpers.LocalDate(ctx, date ) }
		</a>
		<span class="hidden 2xl:inline">
			({ helpers.RelativeDate (ctx, date) })
		</span>
	</span>
	<span class="xl:hidden" title={ helpers.LocalDate(ctx, date) }>
		<a href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-show", id)) }>
			{ date.Format("2006-01-02") }
		</a>
	</span>
}

templ StatsRecordsDistance(rec *database.WorkoutRecord) {
	{{ preferredUnits := helpers.CurrentUser(ctx).PreferredUnits() }}
	<h3>
		@helpers.IconFor(rec.WorkoutType.String())
		{ i18n.T(ctx, "dashboard.records-for", i18n.T(ctx, rec.WorkoutType.StringT())) }
	</h3>
	<table class="workout-info table-auto">
		<tbody>
			<tr>
				<th>
					<span>
						@helpers.IconFor("speed")
						{ i18n.T(ctx, "workout.average-speed") }
					</span>
				</th>
				<td class="font-mono whitespace-nowrap">
					@partials.PreferredSpeedMetric(&rec.WorkoutType, rec.AverageSpeed.Value, preferredUnits)
				</td>
				<td>
					@StatsRecordDate(rec.AverageSpeed.ID, rec.AverageSpeed.Date)
				</td>
			</tr>
			<tr>
				<th>
					<span>
						@helpers.IconFor("speed")
						{ i18n.T(ctx, "workout.average-speed-no-pause") }
					</span>
				</th>
				<td class="font-mono whitespace-nowrap">
					@partials.PreferredSpeedMetric(&rec.WorkoutType, rec.AverageSpeedNoPause.Value, preferredUnits)
				</td>
				<td>
					@StatsRecordDate(rec.AverageSpeedNoPause.ID, rec.AverageSpeedNoPause.Date)
				</td>
			</tr>
			<tr>
				<th>
					<span>
						@helpers.IconFor("max-speed")
						{ i18n.T(ctx, "workout.max-speed") }
					</span>
				</th>
				<td class="font-mono whitespace-nowrap">
					@partials.PreferredSpeedMetric(&rec.WorkoutType, rec.MaxSpeed.Value, preferredUnits)
				</td>
				<td>
					@StatsRecordDate(rec.MaxSpeed.ID, rec.MaxSpeed.Date)
				</td>
			</tr>
			<tr>
				<th>
					<span>
						@helpers.IconFor("distance")
						{ i18n.T(ctx, "workout.total-distance") }
					</span>
				</th>
				<td class="font-mono whitespace-nowrap">
					{ templatehelpers.HumanDistanceFor(preferredUnits.Distance(&rec.WorkoutType))(rec.Distance.Value) } { preferredUnits.Distance(&rec.WorkoutType) }
				</td>
				<td>
					@StatsRecordDate(rec.Distance.ID, rec.Distance.Date)
				</td>
			</tr>
			<tr>
				<th>
					<span>
						@helpers.IconFor("up")
						{ i18n.T(ctx, "workout.total-up") }
					</span>
				</th>
				<td class="font-mono whitespace-nowrap">
					{ helpers.HumanElevation(ctx, rec.TotalUp.Value ) } { preferredUnits.Elevation() }
				</td>
				<td>
					@StatsRecordDate(rec.TotalUp.ID, rec.TotalUp.Date)
				</td>
			</tr>
			<tr>
				<th>
					<span>
						@helpers.IconFor("duration")
						{ i18n.T(ctx, "workout.total-duration") }
					</span>
				</th>
				<td class="font-mono whitespace-nowrap">{ helpers.HumanDuration(rec.Duration.Value) }</td>
				<td>
					@StatsRecordDate(rec.Duration.ID, rec.Duration.Date)
				</td>
			</tr>
		</tbody>
	</table>
}
