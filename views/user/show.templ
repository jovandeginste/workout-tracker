package user

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
	"github.com/jovandeginste/workout-tracker/v2/views/workouts"
)

templ Show(user *database.User, users []*database.User, recentWorkouts []*database.Workout, viewer *database.User) {
	@partials.Page(partials.NewPageOptions()) {
		<h2>
			@helpers.IconFor("dashboard")
			{ i18n.T(ctx, "dashboard.for-user", user.Username) }
			if user.Name != "" && user.Name != user.Username {
				<span class="user-name">({ user.Name })</span>
			}
		</h2>
		@StatsRecordsTotal(user, viewer)
		<div class="lg:flex lg:flex-wrap [&>*]:basis-1/2">
			<div>
				{{ recs, err := user.GetAllRecords(viewer) }}
				if err != nil {
					<pre>{ err.Error() }</pre>
				} else {
					for _, r := range recs {
						if r.WorkoutType.IsDistance() && r.Active {
							<div class="inner-form">
								@StatsRecordsDistance(r)
							</div>
						}
					}
				}
			</div>
			<div>
				@ProfileCalendar()
			</div>
		</div>
		if len(users) > 1 {
			<div class="inner-form">
				<h3>
					@helpers.IconFor("users")
					{ i18n.T(ctx, "dashboard.other-users") }
				</h3>
				<div class="sm:flex sm:flex-wrap gap-5">
					for _, u := range users {
						if u.ID != user.ID {
							<a href={ templ.SafeURL(helpers.RouteFor(ctx, "user-show", u.ID)) }>
								<span class="user-pill">{ u.Username } </span>
							</a>
						}
					}
				</div>
			</div>
		}
		<div class="inner-form recent-activity">
			<h3>
				@helpers.IconFor("workout")
				{ i18n.T(ctx, "dashboard.recent-activity") }
			</h3>
			<div class="sm:flex sm:flex-wrap justify-center">
				for _, w := range recentWorkouts {
					@workouts.Item(w)
				}
			</div>
		</div>
	}
}
