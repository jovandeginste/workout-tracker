package user

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ Heatmap(workoutTypes []database.WorkoutType, selectedTypes []string, selected []database.WorkoutType, equipment []*database.Equipment, selectedEquipment []uint64) {
	@partials.Page(partials.NewPageOptions()) {
		<link rel="stylesheet" type="text/css" href={ helpers.RouteFor(ctx, "assets") + "/views/user/heatmap.css" }/>
		<script src={ helpers.RouteFor(ctx, "assets") + "/views/user/heatmap.js" }></script>
		<h2>
			@helpers.IconFor(`heatmap`)
			{ i18n.T(ctx, "menu.heatmap") }
		</h2>
		<form
			class="inner-form"
			id="heatmap-filter"
			method="get"
			autocomplete="off"
			action={ templ.SafeURL(helpers.RouteFor(ctx, "heatmap")) }
			hx-get={ helpers.RouteFor(ctx, "heatmap") }
			hx-trigger="change"
			hx-swap="none"
			hx-push-url="true"
		>
			@partials.WorkoutTypeFilter(workoutTypes, selectedTypes, equipment, selectedEquipment)
		</form>
		<div id="map-container" data-map-container class="small-size pagebreak">
			<wt-heatmap
				id="map"
				class="border-2 border-black rounded-xl h-[600px] print:w-full print:h-[600px]"
				api-workouts-coordinates-route={ templ.JSONString(helpers.RouteFor(ctx, "api-workouts-coordinates")) }
				api-workouts-centers-route={ templ.JSONString(helpers.RouteFor(ctx, "api-workouts-centers")) }
				types={ templ.JSONString(helpers.WorkoutTypeStrings(selected)) }
				equipment={ templ.JSONString(selectedEquipment) }
				i18n={ templ.JSONString(map[string]string{
          "streets":      i18n.T(ctx, "map.streets"),
          "aerial":       i18n.T(ctx, "map.aerial"),
          "markers":      i18n.T(ctx, "map.markers"),
          "only-visited": i18n.T(ctx, "map.only-visited"),
        }) }
			></wt-heatmap>
			<div class="map-controls flex flex-wrap">
				<div class="grow flex flex-wrap flex-row-reverse">
					<a href="#" title={ i18n.T(ctx, "map.fullscreen") } aria-label={ i18n.T(ctx, "map.fullscreen") } onclick="toggleMapFullscreen('map'); return false;">
						@helpers.IconFor("expand")
					</a>
				</div>
			</div>
		</div>
	}
}
