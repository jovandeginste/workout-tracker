package equipment

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ List(equipment []*database.Equipment, username string) {
	@partials.Page(partials.NewPageOptions()) {
		@partials.ListHeader("equipment", "menu.equipment", len(equipment), "equipment-add", "equipment.add")
		<form
			id="filters"
			method="get"
			action={ templ.SafeURL(helpers.RouteFor(ctx, "equipment")) }
		>
			@partials.UsernameFilter(username)
			<button type="submit">{ i18n.T(ctx, "common.filter") }</button>
		</form>
		<table class="equipment-info">
			<thead>
				<tr>
					<th>{ i18n.T(ctx, "common.name") }</th>
					<th class="hidden md:table-cell">{ i18n.T(ctx, "user.username") }</th>
					<th>{ i18n.T(ctx, "common.active") }</th>
					<th>{ i18n.T(ctx, "menu.workouts") }</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, e := range equipment {
					<tr>
						<td>
							<a href={ templ.SafeURL(helpers.RouteFor(ctx, "equipment-show", e.ID)) }>{ e.Name }</a>
						</td>
						<td class="hidden md:table-cell">
							@helpers.UserLink(&e.User)
						</td>
						<td>
							@templ.Raw(helpers.BoolToHTML(e.Active))
						</td>
						<td>{ helpers.A2S(len(e.Workouts)) }</td>
						<td>
							if e.User.ID == helpers.CurrentUser(ctx).ID {
								<span class="actions">
									@actions(e)
								</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ actions(e *database.Equipment) {
	<form action={ templ.SafeURL(helpers.RouteFor(ctx, "equipment-edit", e.ID)) } method="get">
		<button class="edit" title={ i18n.T(ctx, "common.edit") }>
			<a>
				@helpers.IconFor("edit")
			</a>
		</button>
	</form>
	<button
		hx-get={ helpers.RouteFor(ctx, "equipment-delete-confirm", e.ID) }
		hx-target="#modal-container"
		hx-swap="innerHTML"
		class="dangerous"
		title={ i18n.T(ctx, "common.delete") }
	>
		@helpers.IconFor("delete")
	</button>
	<div id="modal-container">
		// Modal content will be loaded here
	</div>
}

templ DeleteModal(e *database.Equipment) {
	@partials.DeleteModal(
		helpers.RouteFor(ctx, "equipment"),
		helpers.RouteFor(ctx, "equipment-delete", e.ID),
		"misc.equipment",
		e.Name,
		"",
		"",
	)
}
