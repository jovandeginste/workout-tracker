package helpers

import "github.com/jovandeginste/workout-tracker/v2/pkg/database"

templ IconFor(name string) {
	@templ.Raw(iconFor(name))
}

// UserLink shows the name of the user, with their username as a tooltip,
// linking to their dashboard.
templ UserLink(u *database.User) {
	if u != nil && u.ID != 0 {
		<a href={ templ.SafeURL(RouteFor(ctx, "user-show", u.ID)) } title={ u.Username }>
			@IconFor("user")
			{ u.DisplayName() }
		</a>
	}
}
