package admin

import (
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ actions(u *database.User) {
	@partials.ActionForm(helpers.RouteFor(ctx, "admin-user-edit", u.ID), "get", "edit", "common.edit", "edit")
	@partials.DeleteButton(helpers.RouteFor(ctx, "admin-user-delete-confirm", u.ID))
	@partials.ModalContainer()
}

templ DeleteModal(u *database.User) {
	@partials.DeleteModal(
		helpers.RouteFor(ctx, "admin"),
		helpers.RouteFor(ctx, "admin-user-delete", u.ID),
		"common.user",
		u.Name,
		"",
		"",
	)
}
