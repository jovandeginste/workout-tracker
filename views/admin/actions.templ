package admin

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ actions(u *database.User) {
	<form action={ templ.SafeURL(helpers.RouteFor(ctx, "admin-user-edit", u.ID)) } method="get">
		<button class="edit" title={ i18n.T(ctx, "common.edit") }>
			<a>
				@helpers.IconFor("edit")
			</a>
		</button>
	</form>
	<button
		hx-get={ helpers.RouteFor(ctx, "admin-user-delete-confirm", u.ID) }
		hx-target="#modal-container"
		hx-swap="innerHTML"
		class="dangerous"
		title={ i18n.T(ctx, "common.delete") }
	>
		@helpers.IconFor("delete")
	</button>
	<div id="modal-container">
		// Modal content will be loaded here
	</div>
}

templ DeleteModal(u *database.User) {
	@partials.DeleteModal(
		helpers.RouteFor(ctx, "admin"),
		helpers.RouteFor(ctx, "admin-user-delete", u.ID),
		"common.user",
		u.Name,
		"",
		"",
	)
}
