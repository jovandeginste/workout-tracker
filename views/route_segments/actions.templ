package route_segments

import (
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ actions(s *database.RouteSegment) {
	@partials.ActionForm(helpers.RouteFor(ctx, "route-segment-download", s.ID), "get", "download", "common.download", "download")
	@partials.ActionForm(helpers.RouteFor(ctx, "route-segment-edit", s.ID), "get", "edit", "common.edit", "edit")
	@partials.ActionForm(helpers.RouteFor(ctx, "route-segment-refresh", s.ID), "post", "refresh", "common.refresh", "")
	@partials.ActionForm(helpers.RouteFor(ctx, "route-segment-matches", s.ID), "post", "route-segment", "route-segment.find-matches", "")
	@partials.DeleteButton(helpers.RouteFor(ctx, "route-segment-delete-confirm", s.ID))
	@partials.ModalContainer()
}

templ DeleteModal(s *database.RouteSegment) {
	@partials.DeleteModal(
		helpers.RouteFor(ctx, "route-segments"),
		helpers.RouteFor(ctx, "route-segment-delete", s.ID),
		"misc.route-segment",
		s.Name,
		"",
		"",
	)
}
