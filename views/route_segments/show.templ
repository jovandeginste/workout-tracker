package route_segments

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ Show(s *database.RouteSegment) {
	@partials.Page(partials.NewPageOptions()) {
		<div class="gap-4">
			<span class="float-right actions">
				if s.Dirty {
					@partials.DirtyIndicator()
				}
				@actions(s)
			</span>
			<h2>
				@helpers.IconFor("route-segment")
				@Name(s, 0)
			</h2>
			<div class="lg:flex lg:flex-wrap print:block">
				<div data-map-container class="basis-1/2 2xl:basis-1/3 pagebreak">
					<div class="inner-form">
						@RouteSegmentMap(s)
					</div>
				</div>
				<div class="basis-1/2 2xl:basis-1/3">
					<div class="inner-form">
						@details(s)
					</div>
				</div>
				<div class="basis-1/2 2xl:basis-1/3">
					<div class="inner-form overflow-y-auto max-h-[340px] sm:max-h-[440px] md:max-h-[640px] print:max-h-[640px]">
						<table>
							<thead>
								<tr>
									<th title={ i18n.T(ctx, "common.user") }>
										@helpers.IconFor("user")
										{ i18n.T(ctx, "common.user") }
									</th>
									<th>{ i18n.T(ctx, "common.workout") }</th>
									<th class="lg:hidden 3xl:table-cell">{ i18n.T(ctx, "workout.distance") }</th>
									<th>{ i18n.T(ctx, "workout.duration") }</th>
									<th>{ i18n.T(ctx, "workout.tempo") }</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range s.RouteSegmentMatches {
									<tr>
										<td class="max-w-[0px] overflow-hidden whitespace-nowrap text-ellipsis">
											@helpers.UserLink(m.Workout.User)
										</td>
										<td class="max-w-[0px] overflow-hidden whitespace-nowrap text-ellipsis">
											<a href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-show", m.WorkoutID)) }>
												@partials.TruncatedName(m.Workout.Name, 20)
											</a>
										</td>
										<td class="whitespace-nowrap font-mono lg:hidden 3xl:table-cell">
											{ helpers.HumanDistanceForWorkout(ctx, m.Workout, m.Distance) }
											{ helpers.DistanceUnitForWorkout(ctx, m.Workout) }
										</td>
										<td class="whitespace-nowrap font-mono">
											{ helpers.HumanDuration(m.Duration) }
										</td>
										<td class="whitespace-nowrap font-mono">
											{ helpers.HumanTempoForWorkout(ctx, m.Workout, m.AverageSpeed()) }
											{ helpers.TempoUnitForWorkout(ctx, m.Workout) }
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="inner-form h-[300px] md:h-[500px] print:hidden grid grid-rows-[auto_1fr] overflow-hidden">
				<h3>
					@helpers.IconFor("trend")
					{ i18n.T(ctx, "statistics.personal-trend") }
				</h3>
				@ShowStats(s)
			</div>
			<div class="pagebreak">
				if len(s.Notes) > 0 {
					<div class="inner-form">
						<h3>
							@helpers.IconFor("note")
							{ i18n.T(ctx, "common.notes") }
						</h3>
						<div>
							@templ.Raw(helpers.MarkdownToHTML(s.Notes))
						</div>
					</div>
				}
			</div>
		</div>
	}
}
