package route_segments

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ List(segments []*database.RouteSegment) {
	@partials.Page(partials.NewPageOptions()) {
		@partials.ListHeader("route-segment", "menu.route-segments", len(segments), "route-segment-add", "route-segment.add")
		<table class="route-segment-info">
			<thead>
				<tr>
					<th>{ i18n.T(ctx, "common.name") }</th>
					<th class="hidden xl:table-cell">{ i18n.T(ctx, "common.details") }</th>
					<th class="hidden lg:table-cell"></th>
				</tr>
			</thead>
			<tbody>
				for _, s := range segments {
					<tr>
						<td>
							<a href={ templ.SafeURL(helpers.RouteFor(ctx, "route-segment-show", s.ID)) }>
								@Name(s, 20)
							</a>
						</td>
						<th class="hidden xl:table-cell">
							@listDetails(s)
						</th>
						<td class="hidden lg:table-cell">
							if s.Dirty {
								@partials.DirtyIndicator()
							}
							<span class="actions">
								@actions(s)
							</span>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
