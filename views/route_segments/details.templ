package route_segments

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ Name(s *database.RouteSegment, maxLength int) {
	@partials.TruncatedName(s.Name, maxLength)
}

templ details(s *database.RouteSegment) {
	{{ preferredUnits := helpers.CurrentUser(ctx).PreferredUnits() }}
	<table>
		<tbody>
			if s.HasFile() {
				<tr>
					<td>
						@helpers.IconFor("file")
					</td>
					<th>{ i18n.T(ctx, "common.file") }</th>
					<td>{ s.Filename }</td>
				</tr>
			}
			@partials.DetailRow("date", "common.created", "") {
				@partials.SnippetDate(s.CreatedAt)
			}
			@partials.DetailRow("date", "common.updated", "") {
				@partials.SnippetDate(s.UpdatedAt)
			}
			<tr>
				<td>
					@helpers.IconFor("location")
				</td>
				<th>{ i18n.T(ctx, "workout.location") }</th>
				<td>{ s.Address() }</td>
			</tr>
			@partials.DetailRow("bidirectional", "route-segment.bidirectional", "") {
				@templ.Raw(helpers.BoolToHTML(s.Bidirectional))
			}
			@partials.DetailRow("circular", "route-segment.circular", "") {
				@templ.Raw(helpers.BoolToHTML(s.Circular))
			}
			@partials.DetailRow("distance", "workout.total-distance", "whitespace-nowrap font-mono") {
				{ helpers.HumanDistance(ctx, s.TotalDistance) } { preferredUnits.Distance(nil) }
			}
			@partials.DetailRow("elevation", "workout.min-elevation", "whitespace-nowrap font-mono") {
				{ helpers.HumanElevation(ctx, s.MinElevation) } { preferredUnits.Elevation() }
			}
			@partials.DetailRow("elevation", "workout.max-elevation", "whitespace-nowrap font-mono") {
				{ helpers.HumanElevation(ctx, s.MaxElevation) } { preferredUnits.Elevation() }
			}
			@partials.DetailRow("up", "workout.total-up", "whitespace-nowrap font-mono") {
				{ helpers.HumanElevation(ctx, s.TotalUp) } { preferredUnits.Elevation() }
			}
			@partials.DetailRow("down", "workout.total-down", "whitespace-nowrap font-mono") {
				{ helpers.HumanElevation(ctx, s.TotalDown) } { preferredUnits.Elevation() }
			}
		</tbody>
	</table>
}
